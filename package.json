{
  "name": "flux",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "yarn && yarn lint && yarn test && rm -rf client/dist/* && NODE_ENV=production webpack --mode production --bail --progress",
    "dev": "NODE_ENV=development webpack --progress",
    "watch": "NODE_ENV=development webpack --watch --progress",
    "css": "WEBPACK_CHILD=css npm run build",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "yarn lint-js && yarn lint-sass",
    "lint-js": "eslint 'client/**/*.{js,ts}' --ignore-pattern 'client/dist/**' || true",
    "lint-js-fix": "eslint 'client/**/*.{js,ts}' --ignore-pattern 'client/dist/**' --fix",
    "lint-sass": "echo 'No SASS files to lint'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.9",
    "core-js": "^3.26.0",
    "dompurify": "^3.2.7",
    "idiomorph": "^0.7.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.20.0",
    "@silverstripe/eslint-config": "^1.0.0",
    "@silverstripe/webpack-config": "^2.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "jest-cli": "^29.2.2",
    "jest-environment-jsdom": "^29.3.1",
    "react-dom": "^18.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "client/channels",
      "client/cms-live-updates",
      "client/core",
      "client/inline-editor"
    ],
    "moduleDirectories": [
      "client/src",
      "node_modules",
      "../admin/client/src",
      "../admin/node_modules",
      "../silverstripe/admin/client/src",
      "../silverstripe/admin/node_modules",
      "../../silverstripe/admin/client/src",
      "../../silverstripe/admin/node_modules"
    ],
    "testMatch": [
      "**/tests/**/*-test.[jt]s?(x)"
    ],
    "transform": {
      ".*": "babel-jest"
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ],
      "@babel/preset-typescript"
    ]
  }
}
